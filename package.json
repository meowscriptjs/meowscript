{
  "name": "@meowscriptjs/meowscript",
  "version": "1.0.0",
  "description": "MeowScript (.ms) — a catalog-driven DSL compiler that emits PenguinMod .pmp projects.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "meowscript": "bin/meowscript.js",
    "ms": "bin/meowscript.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:example": "node bin/meowscript.js build examples/player -o build/player.pmp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "scratch-vm": "github:PenguinMod/PenguinMod-Vm#develop"
  }
}
